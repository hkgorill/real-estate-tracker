# ─────────────────────────────────────────────
# Google 인증 (둘 중 하나만 필요)
# ─────────────────────────────────────────────
# [권장] Workload Identity Federation (GitHub Actions)
# → 별도 환경변수 불필요. workflow yml에서 google-github-actions/auth 사용

# [권장] 로컬 개발: gcloud CLI 로그인
# → 별도 환경변수 불필요
# gcloud auth application-default login --scopes=https://www.googleapis.com/auth/spreadsheets

# [레거시] Service Account 키 파일 경로
# GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json

# ─────────────────────────────────────────────
# Google Sheets 설정
# ─────────────────────────────────────────────
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# ─────────────────────────────────────────────
# 공공데이터포털 API 키 (국토교통부 실거래가 + 미분양)
# 발급: https://www.data.go.kr → 마이페이지 → 인증키 발급
# ─────────────────────────────────────────────
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# ─────────────────────────────────────────────
# 한국은행 ECOS API 키 (기준금리, 주담대금리)
# 발급: https://ecos.bok.or.kr → 오픈API → 인증키 신청
# ─────────────────────────────────────────────
ECOS_API_KEY=your_ecos_api_key_here

# ─────────────────────────────────────────────
# 한국부동산원 R-ONE API 키 (아파트 가격지수, 전세가율)
# 발급: https://www.reb.or.kr/r-one → 오픈API → 활용신청
# ─────────────────────────────────────────────
RBONE_API_KEY=your_rbone_api_key_here

# ─────────────────────────────────────────────
# 수집 설정 (선택)
# ─────────────────────────────────────────────
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# 출력 설정 (선택)
# ─────────────────────────────────────────────
OUTPUT_CSV=false
OUTPUT_CSV_PATH=./output
